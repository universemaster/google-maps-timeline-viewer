{
  "name": "google-maps-timeline-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:browser",
    "build:browser": "esbuild src/browser-api.ts --bundle --format=iife --global-name=PlacesAnalytics --target=es2020 --outfile=assets/places-analytics.js && esbuild src/workers/analytics.worker.ts --bundle --format=iife --target=es2020 --outfile=assets/analytics-worker.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:start": "npm run build && node dist/src/server/places-server.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
